#!/bin/bash

# Configure the UniFi plugin: controller URL, TLS choice, site and API key.
#
# Usage: unifi-login            interactive setup
#        unifi-login --status   show what is configured (never the key)
#        unifi-login --forget   remove the stored key and configuration
#
# The API key is created in the UniFi Network application under
# Settings → Control Plane → Integrations (Network 9.0 or newer). It is read
# without echo, stored in the keyring, and never written anywhere else.

set -uo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=lib/unifi-common.sh
source "$SCRIPT_DIR/lib/unifi-common.sh" || {
  echo "lib/unifi-common.sh is missing from the plugin folder" >&2
  exit 1
}

for cmd in curl jq secret-tool; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "$cmd is not installed" >&2; exit 1; }
done

nudge_widget() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  omarchy-shell -q "$UNIFI_PLUGIN_ID" refresh >/dev/null 2>&1 || true
}

show_status() {
  if unifi_load_config; then
    echo "Controller: $UNIFI_URL"
    echo "API base:   $UNIFI_API_BASE"
    echo "Site:       ${UNIFI_SITE:-not chosen — run unifi-login}"
    echo "TLS:        $([[ $UNIFI_INSECURE == 1 ]] && echo 'self-signed allowed' || echo 'verified')"
  else
    echo "Controller: not configured"
  fi
  if [[ -n $(unifi_api_key) ]]; then echo "API key:    stored in keyring"
  else echo "API key:    none"; fi
}

case "${1:-}" in
  --status) show_status; exit 0 ;;
  --forget)
    unifi_clear_api_key
    rm -f "$UNIFI_CONFIG_FILE"
    echo "Removed the stored API key and configuration."
    nudge_widget
    exit 0 ;;
  "") ;;
  *) echo "usage: unifi-login [--status|--forget]" >&2; exit 2 ;;
esac

echo "UniFi for Omarchy — setup"
echo
echo "Create an API key in the UniFi Network application:"
echo "  Settings → Control Plane → Integrations → Create API Key"
echo

configured=0
unifi_load_config && configured=1

# On a UniFi network the gateway usually is the console, so offer it as the
# default; 192.168.1.1 is only the fallback when no default route exists.
default_gateway=$(ip -4 route show default 2>/dev/null | awk '/^default via/ { print $3; exit }')
default_url="${UNIFI_URL:-https://${default_gateway:-192.168.1.1}}"
read -r -e -p "Controller URL [$default_url]: " url
url="${url:-$default_url}"
[[ $url == http://* || $url == https://* ]] || url="https://$url"
url="${url%/}"

# Consoles ship with a self-signed certificate, so allowing it is the default
# on first setup; a re-run keeps whatever was chosen before.
if (( configured )); then
  default_insecure=$([[ $UNIFI_INSECURE == 1 ]] && echo Y || echo N)
else
  default_insecure=Y
fi
yn=$([[ $default_insecure == Y ]] && echo "Y/n" || echo "y/N")
read -r -p "Allow a self-signed certificate (most consoles have one)? [$yn]: " answer
answer="${answer:-$default_insecure}"
insecure=$([[ $answer =~ ^[Yy] ]] && echo 1 || echo 0)

existing_key="$(unifi_api_key)"
if [[ -n $existing_key ]]; then
  read -r -s -p "API key (leave empty to keep the stored one): " key
else
  read -r -s -p "API key: " key
fi
echo
key="${key:-$existing_key}"
[[ -n $key ]] || { echo "An API key is required." >&2; exit 1; }
unset existing_key

# Try the key before storing anything, so a typo does not replace a working
# configuration.
UNIFI_URL="$url"; UNIFI_INSECURE="$insecure"
UNIFI_API_BASE="$(unifi_api_base_for "$url")"
echo "Checking $UNIFI_API_BASE …"
unifi_http "/sites" "$key"
if reason=$(unifi_describe_http_failure); then
  echo "Failed: $reason" >&2
  exit 1
fi

# The site is picked from what the controller actually reports rather than
# typed, so a name cannot be misspelt. Only the id is stored: a rename or
# typo fix on the controller must keep polling the same site, and the fetch
# looks the name up itself on its first poll. Newlines are squashed before
# mapfile so a hostile name cannot shift one array against the other.
site_rows=$(jq -r '.data[]? | select(.id != null)
  | [(.id | tostring), (.name // .internalReference // .id | tostring)]
  | map(gsub("[\\r\\n\\t]"; " ") | .[0:120]) | @tsv' <<<"$UNIFI_HTTP_BODY" 2>/dev/null)
mapfile -t site_ids < <(cut -f1 <<<"$site_rows")
mapfile -t site_labels < <(cut -f2 <<<"$site_rows")
if [[ -z $site_rows ]]; then
  echo "The controller answered but listed no sites." >&2
  exit 1
fi

if (( ${#site_ids[@]} == 1 )); then
  chosen=0
  echo "Site: ${site_labels[0]}"
else
  echo
  echo "Sites on this controller:"
  default_choice=1
  for i in "${!site_ids[@]}"; do
    marker=""
    if [[ ${site_ids[$i]} == "$UNIFI_SITE" || ${site_labels[$i]} == "$UNIFI_SITE" ]]; then
      marker="  (current)"
      default_choice=$(( i + 1 ))
    fi
    printf '  %2d) %s%s\n' "$(( i + 1 ))" "${site_labels[$i]}" "$marker"
  done
  while :; do
    read -r -p "Choose a site [$default_choice]: " choice
    choice="${choice:-$default_choice}"
    if [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#site_ids[@]} )); then
      break
    fi
    echo "Enter a number between 1 and ${#site_ids[@]}."
  done
  chosen=$(( choice - 1 ))
  echo "Site: ${site_labels[$chosen]}"
fi

site="${site_ids[$chosen]}"
# The id names URL paths in every later poll, so refuse anything else here.
unifi_is_token "$site" || { echo "The controller returned an unusable site id." >&2; exit 1; }

printf '%s' "$key" | unifi_store_api_key || { echo "Could not store the API key in the keyring." >&2; exit 1; }
unset key
unifi_save_config "$url" "$site" "$insecure"

echo "Signed in."
nudge_widget
