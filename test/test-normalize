#!/bin/bash

# Exercise normalize.jq against a synthetic Integration API response.
# No credentials and no network: everything here runs off fixtures.

set -uo pipefail

TEST_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly TEST_DIR
PLUGIN_DIR="$(dirname -- "$TEST_DIR")"
readonly PLUGIN_DIR
readonly NORMALIZE="$PLUGIN_DIR/normalize.jq"

passed=0
failed=0

check() {
  local name="$1" fixture="$2" filter="$3"
  local out
  if ! out=$(jq -f "$NORMALIZE" <"$TEST_DIR/fixtures/$fixture" 2>&1); then
    printf '  FAIL  %s\n        normalize.jq errored: %s\n' "$name" "$out"
    (( failed++ ))
    return
  fi
  if jq -e "$filter" >/dev/null 2>&1 <<<"$out"; then
    printf '  ok    %s\n' "$name"
    (( passed++ ))
  else
    printf '  FAIL  %s\n        expected: %s\n' "$name" "$filter"
    (( failed++ ))
  fi
}

echo "normalize.jq"

check "reads the site name" network.json '.site.name == "Default"'
check "counts every device" network.json '.summary.devices == 5'
check "counts online devices" network.json '.summary.online == 3'
# CONNECTION_INTERRUPTED means the controller cannot hear the device; for the
# badge and the notification that is offline.
check "counts OFFLINE and CONNECTION_INTERRUPTED as offline" network.json '.summary.offline == 2'
check "counts devices with a firmware update" network.json '.summary.updatable == 1'

check "counts all clients, whatever their type" network.json '.summary.clients == 5'
check "splits wired and wireless clients" network.json '.summary.wired == 2 and .summary.wireless == 2'
check "counts VPN clients separately" network.json '.summary.vpn == 1'
# A device the API flags as a gateway is one, whatever its model says.
if jq -f "$NORMALIZE" <<<'{"devices":[{"id":"g","name":"Box","model":"Custom","state":"ONLINE","features":["gateway","switching"]}]}' |
   jq -e '.devices[0].kind == "gateway"' >/dev/null 2>&1; then
  printf '  ok    the gateway feature marks a gateway\n'
  (( passed++ ))
else
  printf '  FAIL  the gateway feature marks a gateway\n'
  (( failed++ ))
fi
check "attributes clients to their uplink device" network.json \
  '(first(.devices[] | select(.name == "Living Room AP")) | .clients == 2)'
check "a device with no clients reads zero, not null" network.json \
  '(first(.devices[] | select(.name == "Garage AP")) | .clients == 0)'

check "classifies access points" network.json \
  '(first(.devices[] | select(.name == "Living Room AP")) | .kind == "ap")'
check "classifies switches" network.json \
  '(first(.devices[] | select(.name == "Office Switch")) | .kind == "switch")'
# A gateway also reports "switching", so it is told apart by model.
check "classifies a Cloud Gateway as a gateway despite its switching feature" network.json \
  '(first(.devices[] | select(.name == "Gateway")) | .kind == "gateway")'

echo
echo "ordering"
check "the gateway comes first" network.json '.devices[0].name == "Gateway"'
check "online devices precede offline ones" network.json \
  '([.devices[].bucket] | index("offline") > (map(select(. == "online")) | length - 1))'
check "no online device follows an offline one" network.json \
  '([.devices[].bucket] | . as $b | [range(1; length)] | all(. as $i | ($b[$i-1] == "offline") | not or ($b[$i] == "offline")))'
check "access points sort before switches within a group" network.json \
  '([.devices[] | select(.bucket == "online" and .kind != "gateway") | .kind] == ["ap", "switch"])'
check "offline devices keep the same role order" network.json \
  '([.devices[] | select(.bucket == "offline") | .kind] == ["ap", "switch"])'
# An offline gateway still leads: it is the most important thing to notice.
if jq -f "$NORMALIZE" <<<'{"devices":[{"id":"a","name":"AP","state":"ONLINE","features":["accessPoint"]},{"id":"g","name":"UDM","model":"UDM-Pro","state":"OFFLINE","features":["switching"]}]}' |
   jq -e '.devices[0].name == "UDM"' >/dev/null 2>&1; then
  printf '  ok    an offline gateway still leads the list\n'
  (( passed++ ))
else
  printf '  FAIL  an offline gateway still leads the list\n'
  (( failed++ ))
fi
check "a nameless device falls back to its model" network.json \
  '(.devices | map(select(.mac == "aa:bb:cc:00:00:05")) | .[0].name == "USW-Flex-Mini")'
check "keeps the raw state alongside the bucket" network.json \
  '(.devices | map(select(.mac == "aa:bb:cc:00:00:05")) | .[0].state == "CONNECTION_INTERRUPTED" and .[0].bucket == "offline")'

echo
echo "gateway statistics"
check "names the gateway even without statistics" network.json \
  '.gateway.id == "d4" and .gateway.name == "Gateway" and .gateway.stats == null'
# Statistics come from a second request, so the test glues the captured
# response onto the fixture the way unifi-fetch does.
with_stats=$(jq --slurpfile st "$TEST_DIR/fixtures/gateway-stats.json" '. + {stats: $st[0]}' \
  "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" 2>&1)
if jq -e '.gateway.stats.rxBps == 23760 and .gateway.stats.txBps == 14696' >/dev/null 2>&1 <<<"$with_stats"; then
  printf '  ok    reads WAN rates from the uplink block\n'; (( passed++ ))
else
  printf '  FAIL  reads WAN rates from the uplink block\n'; (( failed++ ))
fi
if jq -e '.gateway.stats.cpuPct == 6.2 and .gateway.stats.memPct == 59.1 and .gateway.stats.uptimeSec == 441749 and .gateway.stats.load1 == 1.14' >/dev/null 2>&1 <<<"$with_stats"; then
  printf '  ok    reads load, memory, CPU and uptime\n'; (( passed++ ))
else
  printf '  FAIL  reads load, memory, CPU and uptime\n'; (( failed++ ))
fi
if jq -e '.gateway.stats.heartbeatAt == "2026-08-18T17:55:57Z"' >/dev/null 2>&1 <<<"$with_stats"; then
  printf '  ok    keeps the heartbeat stamp the widget dedups samples on\n'; (( passed++ ))
else
  printf '  FAIL  keeps the heartbeat stamp the widget dedups samples on\n'; (( failed++ ))
fi
if jq -f "$NORMALIZE" <<<'{"devices":[{"id":"a","name":"AP","state":"ONLINE","features":["accessPoint"]}],"stats":{"uptimeSec":1}}' |
   jq -e '.gateway == null' >/dev/null 2>&1; then
  printf '  ok    no gateway means no gateway block, statistics or not\n'; (( passed++ ))
else
  printf '  FAIL  no gateway means no gateway block, statistics or not\n'; (( failed++ ))
fi
if jq -f "$NORMALIZE" <<<'{"devices":[{"id":"g","model":"UDM-Pro","state":"ONLINE"}],"stats":{}}' |
   jq -e '.gateway.stats.rxBps == null and .gateway.stats.uptimeSec == null' >/dev/null 2>&1; then
  printf '  ok    an empty statistics object normalizes to nulls\n'; (( passed++ ))
else
  printf '  FAIL  an empty statistics object normalizes to nulls\n'; (( failed++ ))
fi

echo
echo "gateway report"
check "no report means no history, so the widget falls back to its own samples" network.json \
  '.gateway.history == null'
with_report=$(jq --slurpfile rp "$TEST_DIR/fixtures/gateway-report.json" '. + {report: $rp[0]}' \
  "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" 2>&1)
if jq -e '(.gateway.history | length) == 3' >/dev/null 2>&1 <<<"$with_report"; then
  printf '  ok    keeps only the rows for this gateway'"'"'s MAC\n'; (( passed++ ))
else
  printf '  FAIL  keeps only the rows for this gateway'"'"'s MAC\n'; (( failed++ ))
fi
if jq -e '[.gateway.history[].t] == [1787073600000, 1787073900000, 1787074200000]' >/dev/null 2>&1 <<<"$with_report"; then
  printf '  ok    sorts buckets by time\n'; (( passed++ ))
else
  printf '  FAIL  sorts buckets by time\n'; (( failed++ ))
fi
# 3 750 000 bytes over a 300 s bucket is 100 000 bit/s.
if jq -e '.gateway.history[2].rxBps == 100000 and .gateway.history[2].txBps == 10000' >/dev/null 2>&1 <<<"$with_report"; then
  printf '  ok    converts bucket bytes to average bits per second\n'; (( passed++ ))
else
  printf '  FAIL  converts bucket bytes to average bits per second\n'; (( failed++ ))
fi
# A report whose rows carry some other MAC (a replaced gateway, say) is still
# better than nothing.
if jq -f "$NORMALIZE" <<<'{"devices":[{"id":"g","model":"UDM-Pro","macAddress":"00:00:00:00:00:01","state":"ONLINE"}],"report":[{"time":1,"wan-rx_bytes":300,"wan-tx_bytes":0,"gw":"zz"},{"time":2,"wan-rx_bytes":600,"wan-tx_bytes":0,"gw":"zz"}]}' |
   jq -e '(.gateway.history | length) == 2 and .gateway.history[1].rxBps == 16' >/dev/null 2>&1; then
  printf '  ok    uses every row when none matches the gateway MAC\n'; (( passed++ ))
else
  printf '  FAIL  uses every row when none matches the gateway MAC\n'; (( failed++ ))
fi

echo
echo "WAN state"
check "no health report means no WAN block" network.json '.gateway.wan == null'
with_wan=$(jq --slurpfile h "$TEST_DIR/fixtures/health.json" --slurpfile w "$TEST_DIR/fixtures/wans.json" \
  '. + {health: $h[0], wans: $w[0]}' "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" 2>&1)
wan_check() { # name filter
  if jq -e "$2" >/dev/null 2>&1 <<<"$with_wan"; then printf '  ok    %s\n' "$1"; (( passed++ ))
  else printf '  FAIL  %s\n' "$1"; (( failed++ )); fi
}
wan_check "reads status, address and upstream gateway" \
  '.gateway.wan.status == "ok" and .gateway.wan.ip == "203.0.113.7" and .gateway.wan.gateway == "203.0.113.1"'
wan_check "reads the ISP and its ASN" '.gateway.wan.isp == "Example ISP" and .gateway.wan.asn == 64496'
wan_check "takes latency and uptime from the www subsystem" \
  '.gateway.wan.latencyMs == 14 and .gateway.wan.uptimeSec == 362863'
wan_check "lists every link the controller monitors, in order" \
  '[.gateway.wan.links[].key] == ["WAN", "WAN2"]'
wan_check "names links from /wans when the counts agree" \
  '[.gateway.wan.links[].name] == ["Fibre", "LTE backup"]'
wan_check "a link with uptime and availability is up" \
  '.gateway.wan.links[0].up == true and .gateway.wan.links[0].availabilityPct == 99.5 and .gateway.wan.links[0].latencyMs == 8'
wan_check "the up link is state up" '.gateway.wan.links[0].state == "up"'
# The fixture's WAN2 downtime (444363 s) reaches back to the gateway's boot
# (uptime 444426 s): nothing was ever plugged in.
wan_check "a link down since the gateway booted is unused, not down" \
  '.gateway.wan.links[1].up == false and .gateway.wan.links[1].state == "unused"'
# A link that was up earlier today and has since dropped is a real outage.
if jq --slurpfile h "$TEST_DIR/fixtures/health.json" \
      '. + {health: ($h[0] | map(if .subsystem == "wan" then .uptime_stats.WAN2 = {availability: 40.0, downtime: 3600} else . end))}' \
      "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" |
   jq -e '.gateway.wan.links[1].state == "down"' >/dev/null 2>&1; then
  printf '  ok    a link that dropped after being up is down\n'; (( passed++ ))
else
  printf '  FAIL  a link that dropped after being up is down\n'; (( failed++ ))
fi
if jq --slurpfile h "$TEST_DIR/fixtures/health.json" \
      '. + {health: ($h[0] | map(if .subsystem == "wan" then .uptime_stats.WAN2 = {availability: 0.0, downtime: 3600} else . end))}' \
      "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" |
   jq -e '.gateway.wan.links[1].state == "down"' >/dev/null 2>&1; then
  printf '  ok    a link down for an hour on a five-day-old gateway is down\n'; (( passed++ ))
else
  printf '  FAIL  a link down for an hour on a five-day-old gateway is down\n'; (( failed++ ))
fi
# Names by position are only trustworthy when there is one per link.
if jq --slurpfile h "$TEST_DIR/fixtures/health.json" '. + {health: $h[0], wans: [{"name":"Only one"}]}' \
     "$TEST_DIR/fixtures/network.json" | jq -f "$NORMALIZE" |
   jq -e '[.gateway.wan.links[].name] == ["WAN", "WAN2"]' >/dev/null 2>&1; then
  printf '  ok    falls back to the controller'"'"'s keys when the name count differs\n'; (( passed++ ))
else
  printf '  FAIL  falls back to the controller'"'"'s keys when the name count differs\n'; (( failed++ ))
fi

echo
echo "degenerate input"
for payload in '{}' '{"devices":[]}' '{"devices":[{}],"clients":[{}]}'; do
  if out=$(jq -f "$NORMALIZE" <<<"$payload" 2>&1); then
    printf '  ok    survives %s\n' "$payload"
    (( passed++ ))
  else
    printf '  FAIL  %s errored: %s\n' "$payload" "$out"
    (( failed++ ))
  fi
done
if jq -f "$NORMALIZE" <<<'{"devices":[{}]}' |
   jq -e '.devices[0].bucket == "offline" and .devices[0].name == "Device"' >/dev/null 2>&1; then
  printf '  ok    an empty device object still renders\n'
  (( passed++ ))
else
  printf '  FAIL  an empty device object still renders\n'
  (( failed++ ))
fi

echo
printf '%d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
