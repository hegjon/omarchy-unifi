#!/bin/bash

# Fetch sites, devices and clients from a UniFi Network controller and print
# the flat model the widget renders.
#
# Usage: unifi-fetch
#
# Prints the normalized document on success, or {"error":"…"} on failure —
# exiting 0 either way so the widget can render the reason instead of guessing
# why a process died. A failure that sign-in would fix carries "needsLogin".
#
# Uses the official Network Integration API (Network 9.0+), authenticated with
# an API key from the controller's Control Plane → Integrations page. The key
# is read from the keyring and never reaches argv.

set -uo pipefail
umask 077

readonly PAGE_LIMIT=200

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly NORMALIZE="$SCRIPT_DIR/normalize.jq"

# shellcheck source=lib/unifi-common.sh
source "$SCRIPT_DIR/lib/unifi-common.sh" || {
  printf '{"error":"lib/unifi-common.sh is missing from the plugin folder"}\n'
  exit 0
}

unifi_require_commands
[[ -r $NORMALIZE ]] || die "normalize.jq is missing from the plugin folder"

unifi_load_config || die_needs_login "No UniFi controller configured"
API_KEY="$(unifi_api_key)"
[[ -n $API_KEY ]] || die_needs_login "No UniFi API key stored"

# Fetch every page of a list endpoint into FETCHED as one JSON array. Called
# directly, not inside $(...): a failure has to end the whole script, and
# `exit` inside a command substitution ends only the subshell — the error JSON
# would be captured as if it were data.
FETCHED='[]'
fetch_all() { # path
  local offset=0 total items all='[]' reason
  while :; do
    unifi_http "$1?offset=$offset&limit=$PAGE_LIMIT" "$API_KEY"
    if reason=$(unifi_describe_http_failure); then
      case "$UNIFI_HTTP_CODE" in
        401|403) die_needs_login "$reason" ;;
        *) die "$reason" ;;
      esac
    fi
    jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY" ||
      die "The controller returned a malformed response for $1"
    items=$(jq -c '.data | length' <<<"$UNIFI_HTTP_BODY")
    total=$(jq -r '.totalCount // 0' <<<"$UNIFI_HTTP_BODY")
    all=$(jq -c --argjson page "$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")" '. + $page' <<<"$all")
    (( offset += items ))
    [[ $total =~ ^[0-9]+$ ]] || total=0
    (( items > 0 && offset < total )) || break
  done
  FETCHED="$all"
}

fetch_all "/sites"
sites="$FETCHED"

# The site is chosen by name (the "default" site is called Default in the UI)
# or by id; with nothing configured the first one is used, which is the only
# one on a typical home console.
site=$(jq -c --arg want "$UNIFI_SITE" '
  if length == 0 then null
  elif $want == "" then .[0]
  else (map(select(.id == $want or .name == $want or .internalReference == $want)) | .[0]) // null
  end' <<<"$sites")
[[ $site != null ]] || {
  if [[ -n $UNIFI_SITE ]]; then die "No site named \"$UNIFI_SITE\" on this controller"
  else die "The controller has no sites"; fi
}
site_id=$(jq -r '.id // empty' <<<"$site")
# The id names URL paths and the report cache file from here on, so it has
# to be a plain token; see unifi_is_token.
unifi_is_token "$site_id" || die "The controller returned an unusable site id"

fetch_all "/sites/$site_id/devices"
devices="$FETCHED"
fetch_all "/sites/$site_id/clients"
clients="$FETCHED"

raw=$(jq -n --argjson site "$site" --argjson devices "$devices" --argjson clients "$clients" \
  '{site: $site, devices: $devices, clients: $clients}')

# The gateway's own statistics (WAN rates, load, uptime) are one more request,
# for one device only, and are worth it: they are what the panel graphs. The
# normalizer decides which device is the gateway, so ask it first. A failure
# here is not fatal — the fleet still renders, just without the graph.
stats=null
gateway_id=$(jq -r -f "$NORMALIZE" <<<"$raw" 2>/dev/null | jq -r '.gateway.id // empty' 2>/dev/null)
unifi_is_token "$gateway_id" || gateway_id=""
if [[ -n $gateway_id ]]; then
  unifi_http "/sites/$site_id/devices/$gateway_id/statistics/latest" "$API_KEY"
  if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e 'type == "object"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
    stats="$UNIFI_HTTP_BODY"
  fi
fi

# Twelve hours of WAN traffic in five-minute buckets, from the classic report
# API the UniFi UI's own charts read. It is undocumented, so a failure here is
# never fatal: `report` stays null and the widget graphs its own samples.
# The buckets only move every five minutes, so the answer is cached for four
# and every poll in between reuses it.
# The classic API addresses the site by its internal reference; like the id,
# it is only used if it is a plain token — otherwise the classic requests
# are simply skipped.
site_name=$(jq -r '.internalReference // empty' <<<"$site")
unifi_is_token "$site_name" || site_name=""
report=null
report_cache="${XDG_RUNTIME_DIR:-/tmp}/omarchy-unifi/report-$site_id.json"
if [[ -n $gateway_id ]]; then
  if [[ -f $report_cache ]] && (( $(date +%s) - $(stat -c %Y "$report_cache") < 240 )); then
    report=$(cat "$report_cache")
  else
    now_ms=$(( $(date +%s) * 1000 ))
    body=$(jq -cn --argjson end "$now_ms" \
      '{attrs: ["time", "wan-rx_bytes", "wan-tx_bytes"], start: ($end - 12 * 3600 * 1000), end: $end}')
    if [[ -n $site_name ]]; then
      unifi_http_post "$(unifi_classic_base)/api/s/$site_name/stat/report/5minutes.gw" "$body" "$API_KEY"
      if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
        report=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
        mkdir -p -m 700 "$(dirname "$report_cache")" && printf '%s' "$report" >"$report_cache"
      fi
    fi
  fi
fi

# WAN state: the documented API only names the WAN links, so their names
# come from /wans and everything else — status, address, ISP, latency,
# per-link availability — from the classic stat/health, which is small and
# changes every heartbeat, so it is not cached. Both are optional: without
# them the gateway block simply has no WAN lines.
wans=null
health=null
if [[ -n $gateway_id ]]; then
  unifi_http "/sites/$site_id/wans?limit=50" "$API_KEY"
  if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
    wans=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
  fi
  if [[ -n $site_name ]]; then
    UNIFI_API_BASE_SAVED="$UNIFI_API_BASE"
    UNIFI_API_BASE="$(unifi_classic_base)"
    unifi_http "/api/s/$site_name/stat/health" "$API_KEY"
    UNIFI_API_BASE="$UNIFI_API_BASE_SAVED"
    if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
      health=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
    fi
  fi
fi

unset API_KEY

jq --argjson stats "$stats" --argjson report "$report" --argjson wans "$wans" --argjson health "$health" \
  '. + {stats: $stats, report: $report, wans: $wans, health: $health}' <<<"$raw" |
  jq -f "$NORMALIZE" 2>/dev/null || die "Could not interpret the controller response"
