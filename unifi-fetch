#!/bin/bash

# Fetch devices and clients for the configured site from a UniFi Network
# controller and print the flat model the widget renders. unifi-login stores
# which site by id; the name and classic-API reference come from /sites.
#
# Usage: unifi-fetch [--site=<id> --site-ref=<reference>]
#
# The widget hands back the site it learned from an earlier poll, so only
# the first poll after a (re)start — or any run without the flags — asks
# the controller for the site. The pair counts only when the id matches the
# configured site: after unifi-login switches sites, the stale reference is
# ignored and the lookup runs again.
#
# Prints the normalized document on success, or {"error":"…"} on failure —
# exiting 0 either way so the widget can render the reason instead of guessing
# why a process died. A failure that sign-in would fix carries "needsLogin".
#
# Uses the official Network Integration API (Network 9.0+), authenticated with
# an API key from the controller's Control Plane → Integrations page. The key
# is read from the keyring and never reaches argv.

set -uo pipefail
umask 077

readonly PAGE_LIMIT=200
# Pages per list: a backstop against a controller that keeps paging while
# claiming a total the pages never reach.
readonly MAX_PAGES=5

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly NORMALIZE="$SCRIPT_DIR/normalize.jq"

# shellcheck source=lib/unifi-common.sh
source "$SCRIPT_DIR/lib/unifi-common.sh" || {
  printf '{"error":"lib/unifi-common.sh is missing from the plugin folder"}\n'
  exit 0
}

unifi_require_commands
[[ -r $NORMALIZE ]] || die "normalize.jq is missing from the plugin folder"

KNOWN_SITE=""
KNOWN_REF=""
for arg in "$@"; do
  case "$arg" in
    --site=*) KNOWN_SITE="${arg#--site=}" ;;
    --site-ref=*) KNOWN_REF="${arg#--site-ref=}" ;;
    *) die "unifi-fetch takes only --site=<id> and --site-ref=<reference>" ;;
  esac
done

unifi_load_config || die_needs_login "No UniFi controller configured"
API_KEY="$(unifi_api_key)"
[[ -n $API_KEY ]] || die_needs_login "No UniFi API key stored"

# Fetch every page of a list endpoint into FETCHED as one JSON array. Called
# directly, not inside $(...): a failure has to end the whole script, and
# `exit` inside a command substitution ends only the subshell — the error JSON
# would be captured as if it were data.
FETCHED='[]'
fetch_all() { # path
  local offset=0 total items all='[]' reason pages=0
  while :; do
    (( pages++ < MAX_PAGES )) || die "The controller keeps paging $1 without end"
    unifi_http "$1?offset=$offset&limit=$PAGE_LIMIT" "$API_KEY"
    if reason=$(unifi_describe_http_failure); then
      case "$UNIFI_HTTP_CODE" in
        401|403) die_needs_login "$reason" ;;
        *) die "$reason" ;;
      esac
    fi
    jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY" ||
      die "The controller returned a malformed response for $1"
    items=$(jq -c '.data | length' <<<"$UNIFI_HTTP_BODY")
    total=$(jq -r '.totalCount // 0' <<<"$UNIFI_HTTP_BODY")
    [[ $total =~ ^[0-9]+$ ]] || total=0
    # Both inputs reach jq on stdin: spliced into argv, a page would be
    # capped by the kernel's argument-size limit instead of by us, and the
    # merge would fail confusingly on any page past ~128 KB.
    all=$(printf '%s\n%s\n' "$all" "$UNIFI_HTTP_BODY" | jq -c '. + input.data')
    # Pages within the limit must not add up past it: the accumulated array
    # obeys the same budget as a single response.
    (( ${#all} <= UNIFI_MAX_BODY_BYTES )) ||
      die "The controller sent more than $(( UNIFI_MAX_BODY_BYTES / 1024 / 1024 )) MB of $1"
    (( offset += items ))
    (( items > 0 && offset < total )) || break
  done
  FETCHED="$all"
}

# The config pins the site by id — a rename or typo fix on the controller
# must keep polling the same site. The id names URL paths and cache files
# from here on, so it has to be a plain token (see unifi_is_token).
site_id="$UNIFI_SITE"
unifi_is_token "$site_id" ||
  die_needs_login "No usable site id is stored — run unifi-login again"

# The widget remembers the site between polls and hands it back on argv, so
# the controller is only asked when nothing usable was passed. An empty
# reference passed with the right id is itself an answer ("this site has
# none") and does not trigger a lookup — it only costs the WAN details.
site=""
if [[ -n $KNOWN_SITE && $KNOWN_SITE == "$site_id" ]]; then
  ref="$KNOWN_REF"
  unifi_is_token "$ref" || ref=""
  site=$(jq -cn --arg id "$site_id" --arg ref "$ref" \
    '{id: $id, name: "", internalReference: (if $ref == "" then null else $ref end)}')
fi
if [[ -z $site ]]; then
  # One filtered row is all that is needed. The id goes into the filter as a
  # bare UUID — quoted, the filter language types it STRING and mismatches.
  # The row's id is checked rather than trusted to have been filtered, and a
  # controller that cannot answer this (filtering postdates Network 9.0)
  # gets the plain list walk instead.
  unifi_http "/sites?filter=id.eq($site_id)&limit=1" "$API_KEY"
  [[ $UNIFI_HTTP_CODE == 200 ]] &&
    site=$(jq -c --arg id "$site_id" \
      '.data[0]? // empty | select(type == "object" and .id == $id)' <<<"$UNIFI_HTTP_BODY" 2>/dev/null)
  if [[ -z $site ]]; then
    # No filter support: one plain page at the API's default limit (25) is
    # plenty — a controller with more sites than that also has filtering.
    unifi_http "/sites" "$API_KEY"
    if reason=$(unifi_describe_http_failure); then
      case "$UNIFI_HTTP_CODE" in
        401|403) die_needs_login "$reason" ;;
        *) die "$reason" ;;
      esac
    fi
    jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY" ||
      die "The controller returned a malformed response for /sites"
    site=$(jq -c --arg id "$site_id" \
      '.data | map(select(.id == $id)) | .[0] // empty' <<<"$UNIFI_HTTP_BODY")
    [[ -n $site ]] ||
      die_needs_login "The stored site is gone from this controller — run unifi-login again"
  fi
fi

fetch_all "/sites/$site_id/devices"
devices="$FETCHED"
fetch_all "/sites/$site_id/clients"
clients="$FETCHED"

raw=$(jq -n --argjson site "$site" --argjson devices "$devices" --argjson clients "$clients" \
  '{site: $site, devices: $devices, clients: $clients}')

# The gateway's own statistics (WAN rates, load, uptime) are one more request,
# for one device only, and are worth it: they are what the panel graphs. The
# normalizer decides which device is the gateway, so ask it first. A failure
# here is not fatal — the fleet still renders, just without the graph.
stats=null
gateway_id=$(jq -r -f "$NORMALIZE" <<<"$raw" 2>/dev/null | jq -r '.gateway.id // empty' 2>/dev/null)
unifi_is_token "$gateway_id" || gateway_id=""
if [[ -n $gateway_id ]]; then
  unifi_http "/sites/$site_id/devices/$gateway_id/statistics/latest" "$API_KEY"
  if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e 'type == "object"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
    stats="$UNIFI_HTTP_BODY"
  fi
fi

# Twelve hours of WAN traffic in five-minute buckets, from the classic report
# API the UniFi UI's own charts read. It is undocumented, so a failure here is
# never fatal: `report` stays null and the widget graphs its own samples.
# The buckets only move every five minutes, so the answer is cached for four
# and every poll in between reuses it.
# The classic API addresses the site by its internal reference; like the id,
# it is only used if it is a plain token — otherwise the classic requests
# are simply skipped.
site_name=$(jq -r '.internalReference // empty' <<<"$site")
unifi_is_token "$site_name" || site_name=""
# The cache lives only in the per-user runtime dir: a shared /tmp fallback
# would let another local user pre-create the directory and plant a
# symlink where the report is written. Without a runtime dir there is no
# cache and the report is simply fetched every poll.
report=null
report_cache=""
[[ -n ${XDG_RUNTIME_DIR:-} ]] && report_cache="$XDG_RUNTIME_DIR/omarchy-unifi/report-$site_id.json"
if [[ -n $gateway_id ]]; then
  if [[ -n $report_cache && -f $report_cache ]] && (( $(date +%s) - $(stat -c %Y "$report_cache") < 240 )); then
    report=$(cat "$report_cache")
  else
    now_ms=$(( $(date +%s) * 1000 ))
    body=$(jq -cn --argjson end "$now_ms" \
      '{attrs: ["time", "wan-rx_bytes", "wan-tx_bytes"], start: ($end - 12 * 3600 * 1000), end: $end}')
    if [[ -n $site_name ]]; then
      unifi_http_post "$(unifi_classic_base)/api/s/$site_name/stat/report/5minutes.gw" "$body" "$API_KEY"
      if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
        report=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
        # $XDG_RUNTIME_DIR is ours already; umask 077 keeps our directory private.
        [[ -n $report_cache ]] && mkdir -p "$(dirname "$report_cache")" && printf '%s' "$report" >"$report_cache"
      fi
    fi
  fi
fi

# WAN state: the documented API only names the WAN links, so their names
# come from /wans and everything else — status, address, ISP, latency,
# per-link availability — from the classic stat/health, which is small and
# changes every heartbeat, so it is not cached. Both are optional: without
# them the gateway block simply has no WAN lines.
wans=null
health=null
if [[ -n $gateway_id ]]; then
  unifi_http "/sites/$site_id/wans?limit=50" "$API_KEY"
  if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
    wans=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
  fi
  if [[ -n $site_name ]]; then
    UNIFI_API_BASE_SAVED="$UNIFI_API_BASE"
    UNIFI_API_BASE="$(unifi_classic_base)"
    unifi_http "/api/s/$site_name/stat/health" "$API_KEY"
    UNIFI_API_BASE="$UNIFI_API_BASE_SAVED"
    if [[ $UNIFI_HTTP_CODE == 200 ]] && jq -e '.data | type == "array"' >/dev/null 2>&1 <<<"$UNIFI_HTTP_BODY"; then
      health=$(jq -c '.data' <<<"$UNIFI_HTTP_BODY")
    fi
  fi
fi

unset API_KEY

# $site_name is the token-checked reference (empty when unusable): what the
# widget gets to hand back on the next poll's argv is only ever that, never
# the controller's raw string.
jq --argjson stats "$stats" --argjson report "$report" --argjson wans "$wans" --argjson health "$health" \
  --arg siteRef "$site_name" \
  '. + {stats: $stats, report: $report, wans: $wans, health: $health, siteRef: $siteRef}' <<<"$raw" |
  jq -f "$NORMALIZE" 2>/dev/null || die "Could not interpret the controller response"
